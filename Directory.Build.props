<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Central Package Management (CPM): every package version lives in
         Directory.Packages.props, not in individual .csproj files. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <!-- Single top-level build output folder instead of scattered bin/obj
         under every project: artifacts/bin, artifacts/obj, artifacts/package. -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>
</Project>
